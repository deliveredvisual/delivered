{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "delivered-visual",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // Every minute: carry on copying uploads to Dropbox / Google Drive (worker.ts → /api/cloud/pump).
  "triggers": { "crons": ["* * * * *"] },
  // Database: created in the Cloudflare dashboard (D1 → delivered-visual).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "delivered-visual",
      "database_id": "d9285aed-60dc-46b3-bb82-a3b1b089bdcc",
      "migrations_dir": "drizzle"
    }
  ],
  // File storage: create with `npx wrangler r2 bucket create delivered-visual-files`.
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "delivered-visual-files"
    }
  ],
  "vars": {
    "STUDIO_NAME": "Alec Pender",
    "STUDIO_EMAIL": "hello@alecpender.com"
  }
  // Secrets (set with `npx wrangler secret put NAME`): ADMIN_PASSWORD, SESSION_SECRET
  // Optional, for copying uploads: DROPBOX_APP_KEY, DROPBOX_APP_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET
}
